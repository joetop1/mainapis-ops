APP_ORIGIN=https://ops.mainapis.com
PORT=3080
HOST=0.0.0.0
DATA_DIR=/app/data
CASDOOR_ISSUER=https://auth.mainapis.com
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# Comma-separated exact OIDC sub values permitted to use this internal console.
ALLOWED_SUBJECTS=
# Exact Casdoor sub(s) allowed to change global branding.
# If omitted, only a sole ALLOWED_SUBJECTS account is the system administrator.
# With multiple allowed accounts, explicitly configure this list.
# SYSTEM_ADMIN_SUBJECTS=
# Server-side production Webhook URL copied from an activated n8n workflow.
N8N_WEBHOOK_URL=
# Configure the same value as an n8n Header Auth credential, header X-Ops-Token.
N8N_WEBHOOK_TOKEN=
DEMO_MODE=false

# Independent multi-store workflow; never reuse the membership merchant credentials.
N8N_STORE_WEBHOOK_URL=
N8N_STORE_WEBHOOK_TOKEN=

# Daily consistent SQLite + connections.key backups, retained inside the data volume.
# Copy verified backups off-server separately for disk-loss protection.
OPS_AUTO_BACKUP=true
OPS_BACKUP_INTERVAL_HOURS=24
OPS_BACKUP_KEEP=14

# Compose enables the durable publication queue for both services automatically.
# For manual Node deployment, set this for BOTH server.mjs and worker.mjs.
# OPS_DURABLE_QUEUE=true

# Set true BEFORE starting services against a restored database; reconcile queued
# jobs with mall records before resuming. Recreate both services after changing.
OPS_WORKER_PAUSED=false

# Off-server encrypted backups to configured OSS (private ops-private/backups/).
# Keep this independent 32-byte Base64 key OFF SERVER as well: without it restores fail.
# Generate with: openssl rand -base64 32
OPS_OFFSITE_BACKUP=false
OPS_OFFSITE_ENCRYPTION_KEY=
# Optional dedicated WeCom group robot. Never reuse customer event templates here.
OPS_OPERATIONS_WEBHOOK=

# Supplier Excel AI recognition (OpenAI-compatible NewAPI).
# With a key and model configured, upload previews call this service automatically.
OPS_SUPPLIER_AI_BASE_URL=https://api.mainapis.com/v1
OPS_SUPPLIER_AI_KEY=
OPS_SUPPLIER_AI_MODEL=

# Historical compatibility only. New publishing defaults to OPS adapters.
OPS_LEGACY_N8N_PUBLISH=false
